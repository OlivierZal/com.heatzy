{
  "name": "com.heatzy",
  "version": "23.3.8",
  "description": "Heatzy for Homey",
  "homepage": "https://github.com/OlivierZal/com.heatzy/",
  "bugs": {
    "url": "https://github.com/OlivierZal/com.heatzy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OlivierZal/com.heatzy.git"
  },
  "license": "GPL-3.0-only",
  "author": "Olivier Zalmanski",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "npm run build:assets && node ./node_modules/@typescript/native/bin/tsc --project tsconfig.build.json",
    "build:assets": "node scripts/bundle.mts",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "homey:install": "npx homey app install",
    "homey:start": "npx homey app run --remote",
    "homey:validate": "npx homey app validate --level=publish",
    "lint": "node --max-old-space-size=8192 ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:coverage": "npm test -- --coverage",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit"
  },
  "prettier": "@olivierzal/configs/prettier",
  "dependencies": {
    "@olivierzal/heatzy-api": "20.0.0",
    "@olivierzal/homey-kit": "6.2.1",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@olivierzal/configs": "6.4.1",
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/node": "^26.5.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "happy-dom": "20.14.0",
    "homey-apps-sdk-v3-types": "^0.3.12",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  }
}
